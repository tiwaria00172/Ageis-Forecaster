# Byte-compiled / optimised
__pycache__/
*.py[cod]
*$py.class

# Distribution
*.egg-info/
dist/
build/

# Virtual environments
venv/
.venv/
env/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Data files (keep sample, ignore raw/processed)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Model checkpoints (can be large)
models/checkpoints/*
models/saved/*
!models/checkpoints/.gitkeep
!models/saved/.gitkeep

# Logs
logs/
*.log

# Jupyter
.ipynb_checkpoints/
